# ==============================================================================
# Environment Configuration Template for Viqar Portfolio
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Public Supabase Project Endpoint
# Accessible on both client and server for build-time static fetching and client auth.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public Supabase Anonymous API Key
# Client-safe key enforcing Row Level Security (RLS) for read-only published content.
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_PLACEHOLDER

# Server-Side Supabase Project Endpoint
# Server-side endpoint for SSR authentication and database seeding operations.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# High-Privilege Supabase Service Role Key
# DANGER: Bypasses Row Level Security. Used strictly for database seeding and server-side administration.
# NEVER expose to client-side bundles, commit to git, or leak in logs.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel / Host Deployment Rebuild Webhook
# Triggered by the Admin CMS "Publish site" button to rebuild and deploy updated static content.
DEPLOY_HOOK_URL=

# Canonical Production Website Domain
# Used for canonical URL tags, Open Graph meta tags, and XML sitemap generation.
SITE_URL=https://viqar.dev
