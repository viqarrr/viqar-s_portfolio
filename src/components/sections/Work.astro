---
import type { SiteSettings, Project } from '../../lib/content';

export interface Props {
  settings?: SiteSettings;
  projects?: Project[];
}

const { settings, projects = [] } = Astro.props;
const workLead = settings?.work_lead ?? 'Five featured software, mobile, and game projects developed with modern frameworks.';
const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '').trim();
---

<section id="work" data-8b-section="work" aria-labelledby="work-title">
  <div class="work__plate" aria-hidden="true"></div>
  <div class="work__stage">
    <div class="work__head">
      <h2 class="m-text-3" id="work-title">Selected work<span class="m-dot" aria-hidden="true"></span></h2>
      <p class="m-text-5 work__lead">{workLead}</p>
    </div>
    <div class="work__window">
      <ul class="work__track">
        {projects.map((project, index) => (
          <li class="case" data-project-slug={project.slug} tabindex="0" role="button" aria-label={`View project ${project.name}`}>
            <div class="case__media"><img srcset={project.image_srcset} sizes={project.image_sizes} style={`background:${project.image_bg}`} class="case__img" src={project.image_src} width={project.image_width} height={project.image_height} alt={project.image_alt} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" /></div>
            <span class="m-badge case__tag">{project.tag}</span>
            <div class="case__text"><h3 class="m-text-4 case__name">{project.name}</h3><p class="m-text-5 case__line">{stripHtml(project.line).substring(0, 100)}...</p></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
