---
import type { Project, SiteSettings } from '../../lib/content';

export interface Props {
  project?: Project;
  settings?: SiteSettings;
  hidden?: boolean;
}

const { project, settings, hidden = true } = Astro.props;
const liveUrl = (project?.live_url ?? '').trim();
const githubUrl = (project?.github_url ?? '').trim();
---

<article id="project-detail" aria-labelledby="pdetail-title" hidden={hidden}>
  <div class="pdetail__wrap">
    <button type="button" class="pdetail__back" id="pdetail-back">
      <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      <span>Back to projects</span>
    </button>

    <div class="pdetail__hero" id="pdetail-hero" style={project?.image_bg ? `background:${project.image_bg}` : undefined}>
      <img
        id="pdetail-img"
        src={project?.image_src ?? ''}
        srcset={project?.image_srcset ?? ''}
        sizes={project?.image_sizes ?? '(max-width: 900px) 94vw, 78rem'}
        width={project?.image_width ?? 1600}
        height={project?.image_height ?? 1000}
        alt={project?.image_alt ?? ''}
      />
    </div>

    <header class="pdetail__head" data-pdetail-anim>
      <div class="pdetail__heading">
        <span class="m-badge pdetail__tag" id="pdetail-tag">{project?.tag ?? ''}</span>
        <h1 class="pdetail__title" id="pdetail-title"><span id="pdetail-name">{project?.name ?? ''}</span><span class="m-dot" aria-hidden="true"></span></h1>
      </div>
    </header>

    <div class="pdetail__main" data-pdetail-anim>
      <div class="pdetail__block">
        <span class="pdetail__label">Description</span>
        <div class="pdetail__desc" id="pdetail-desc" set:html={project?.line ?? ''}></div>
      </div>

      <!-- Prominent Action CTA Bar right under description -->
      <div class="pdetail__cta-bar gap-4 flex-wrap mt-8 pt-8 border-t border-white/10" id="pdetail-action-bar" data-pdetail-anim>
        <a
          id="pdetail-live-btn"
          class="pdetail__btn-primary rounded-full min-h-[48px] px-7 py-3 bg-[#f6db00] text-[#0d0c11] font-bold text-sm tracking-tight hover:opacity-90 active:scale-[0.98] transition flex items-center gap-2"
          href={liveUrl || '#'}
          target="_blank"
          rel="noopener noreferrer"
          style={project && !liveUrl ? 'display: none;' : undefined}
        >
          <span>Live Preview</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          id="pdetail-github-btn"
          class="pdetail__btn-secondary rounded-full min-h-[48px] px-7 py-3 bg-[#1f1d26] text-white font-semibold text-sm hover:bg-[#2a2734] active:scale-[0.98] transition flex items-center gap-2"
          href={githubUrl || '#'}
          target="_blank"
          rel="noopener noreferrer"
          style={project && !githubUrl ? 'display: none;' : undefined}
        >
          <span>GitHub / Code</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</article>
