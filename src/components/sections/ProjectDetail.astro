---
import type { Project, SiteSettings } from '../../lib/content';

export interface Props {
  project?: Project;
  settings?: SiteSettings;
  hidden?: boolean;
}

const { hidden = true } = Astro.props;
---

<article id="project-detail" aria-labelledby="pdetail-title" hidden={hidden}>
  <div class="pdetail__wrap">
    <button type="button" class="pdetail__back" id="pdetail-back">
      <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      <span>Back to projects</span>
    </button>

    <div class="pdetail__hero" id="pdetail-hero">
      <img id="pdetail-img" src="" srcset="" sizes="" width="1600" height="1000" alt="" />
    </div>

    <header class="pdetail__head" data-pdetail-anim>
      <h1 class="pdetail__title" id="pdetail-title"><span id="pdetail-name"></span><span class="m-dot" aria-hidden="true"></span></h1>
      <div class="pdetail__actions" id="pdetail-action-bar">
        <a class="m-icon" id="pdetail-github" href="https://github.com/placeholder" target="_blank" rel="noopener noreferrer" aria-label="Source Code on GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
        <a class="m-icon" id="pdetail-live" href="#" target="_blank" rel="noopener noreferrer" aria-label="Live Preview">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M5 4h7v7"/></svg>
        </a>
      </div>
    </header>

    <div class="pdetail__grid">
      <aside class="pdetail__meta">
        <div class="pdetail__block" data-pdetail-anim>
          <span class="pdetail__label">Year</span>
          <p class="pdetail__year" id="pdetail-year">2025</p>
        </div>
        <div class="pdetail__block" data-pdetail-anim>
          <span class="pdetail__label">Tech &amp; Technique</span>
          <ul class="pdetail__tags" id="pdetail-tags"></ul>
        </div>
      </aside>

      <div class="pdetail__main">
        <div class="pdetail__block" data-pdetail-anim>
          <span class="pdetail__label">Description</span>
          <p class="pdetail__desc" id="pdetail-desc"></p>
          <p class="pdetail__features-title">Key Features:</p>
          <ul class="pdetail__features" id="pdetail-features"></ul>
        </div>
        <div class="pdetail__block" data-pdetail-anim>
          <span class="pdetail__label">My Role</span>
          <p class="pdetail__role-title" id="pdetail-role"></p>
          <p class="pdetail__desc" id="pdetail-responsibilities"></p>
        </div>
      </div>
    </div>

    <div class="pdetail__cta" data-pdetail-anim>
      <p class="pdetail__cta-sub">Have a project in mind?</p>
      <a class="pdetail__cta-mail" href="mailto:viqar@example.com">viqar@example.com</a>
    </div>
  </div>
</article>
