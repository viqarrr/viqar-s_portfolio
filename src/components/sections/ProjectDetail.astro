---
import type { Project, SiteSettings, ContactLink } from '../../lib/content';
import { resolveContactLinks } from '../../lib/content';

export interface Props {
  project?: Project;
  settings?: SiteSettings;
  contactLinks?: ContactLink[];
  hidden?: boolean;
}

const { hidden = true, project, settings, contactLinks = [] } = Astro.props;
const resolved = resolveContactLinks(contactLinks);
const email = resolved.email || settings?.email || 'viqar@example.com';
const emailHref = (resolved.emailHref && resolved.emailHref !== '#contact')
  ? resolved.emailHref
  : (settings?.email ? `mailto:${settings.email}` : 'mailto:viqar@example.com');

const isValidUrl = (url?: string | null): boolean => {
  if (!url || typeof url !== 'string') return false;
  const trimmed = url.trim();
  if (!trimmed || trimmed === '#' || trimmed === 'null' || trimmed === 'undefined') return false;
  try {
    const parsed = new URL(trimmed);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:';
  } catch {
    return false;
  }
};

const hasLive = isValidUrl(project?.live_url);
const hasGithub = isValidUrl(project?.github_url);
const hasAnyAction = hasLive || hasGithub;
const liveUrl = hasLive ? project!.live_url!.trim() : '';
const githubUrl = hasGithub ? project!.github_url!.trim() : '';
---

<article id="project-detail" aria-labelledby="pdetail-title" hidden={hidden}>
  <div class="pdetail__wrap">
    <button type="button" class="pdetail__back" id="pdetail-back">
      <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      <span>Back to projects</span>
    </button>

    <div class="pdetail__hero" id="pdetail-hero" style={project?.image_bg ? `background:${project.image_bg}` : undefined}>
      <img
        id="pdetail-img"
        src={project?.image_src ?? ''}
        srcset={project?.image_srcset ?? ''}
        sizes={project?.image_sizes ?? '(max-width: 900px) 94vw, 78rem'}
        width={project?.image_width ?? 1600}
        height={project?.image_height ?? 1000}
        alt={project?.image_alt ?? project?.name ?? ''}
      />
    </div>

    <header class="pdetail__head" data-pdetail-anim>
      <h1 class="pdetail__title" id="pdetail-title"><span id="pdetail-name">{project?.name ?? ''}</span><span class="m-dot" aria-hidden="true"></span></h1>
      <div
        class="pdetail__actions"
        id="pdetail-action-bar"
        style={hasAnyAction ? undefined : 'display: none;'}
      >
        <a
          class="m-icon pdetail__btn pdetail__btn--secondary"
          id="pdetail-github"
          href={hasGithub ? githubUrl : undefined}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub / Code ↗"
          style={hasGithub ? undefined : 'display: none;'}
        >
          <svg class="pdetail__btn-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="none" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span class="pdetail__btn-text">GitHub / Code ↗</span>
        </a>
        <a
          class="m-icon pdetail__btn pdetail__btn--primary"
          id="pdetail-live"
          href={hasLive ? liveUrl : undefined}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Live Preview ↗"
          style={hasLive ? undefined : 'display: none;'}
        >
          <svg class="pdetail__btn-icon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12 12 4M5 4h7v7"></path>
          </svg>
          <span class="pdetail__btn-text">Live Preview ↗</span>
        </a>
      </div>
    </header>

    <div class="pdetail__grid">
      <div class="pdetail__main">
        <div class="pdetail__block" data-pdetail-anim>
          <span class="pdetail__label">Description</span>
          <div class="pdetail__desc" id="pdetail-desc" set:html={project?.line ?? ''}></div>
        </div>
      </div>
    </div>

    <div class="pdetail__cta" data-pdetail-anim>
      <p class="pdetail__cta-sub">Have a project in mind?</p>
      <a class="pdetail__cta-mail" id="pdetail-cta-mail" href={emailHref}>{email}</a>
    </div>
  </div>
</article>
