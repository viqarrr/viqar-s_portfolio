---
import type { SiteSettings, ContactLink } from '../../lib/content';
import { resolveContactLinks } from '../../lib/content';

export interface Props {
  settings?: SiteSettings;
  contactLinks?: ContactLink[];
}

const { settings, contactLinks = [] } = Astro.props;
const brandName = settings?.brand_name ?? 'Viqar';
const lenStyle = `--len:${brandName.length}`;

const resolved = resolveContactLinks(contactLinks);
const githubHref = resolved.githubHref || settings?.github_url || undefined;
const linkedinHref = resolved.linkedinHref || settings?.linkedin_url || undefined;
const instagramHref = resolved.instagramHref || settings?.instagram_url || undefined;
const emailHref = (resolved.emailHref && resolved.emailHref !== '#contact')
  ? resolved.emailHref
  : (settings?.email ? `mailto:${settings.email}` : undefined);
const emailText = resolved.email || settings?.email || 'viqar@example.com';
---

<footer id="footer" class="footer" data-8b-section="footer">
  <div class="wrap">
    <p class="m-text-2 footer__word" style={lenStyle} data-8b-motion="register">{brandName}<span class="m-dot" aria-hidden="true"></span></p>
    <div class="footer__cols">
      <nav class="footer__nav" aria-label="Footer">
        <ul>
          <li><a class="footer__link" href="#work">Work</a></li>
          <li><a class="footer__link" href="#again">Skills</a></li>
          <li><a class="footer__link" href="#capabilities">Recognitions</a></li>
          <li><a class="footer__link" href="#method">Experience</a></li>
          <li><a class="footer__link" href="#contact">Contact</a></li>
        </ul>
      </nav>
      <div class="footer__right">
        <ul class="footer__social">
          {githubHref && <li><a class="footer__link" href={githubHref} target="_blank" rel="noopener noreferrer">{resolved.githubLink?.label || 'GitHub'}</a></li>}
          {linkedinHref && <li><a class="footer__link" href={linkedinHref} target="_blank" rel="noopener noreferrer">{resolved.linkedinLink?.label || 'LinkedIn'}</a></li>}
          {instagramHref && <li><a class="footer__link" href={instagramHref} target="_blank" rel="noopener noreferrer">{resolved.instagramLink?.label || 'Instagram'}</a></li>}
          {emailHref && <li><a class="footer__link" href={emailHref}>{emailText}</a></li>}
        </ul>
        <a class="footer__to-top" href="#hero" aria-label="Back to top">
          <span class="footer__to-top-dot" aria-hidden="true"></span>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
