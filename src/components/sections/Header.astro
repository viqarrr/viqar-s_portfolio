---
import type { SiteSettings } from '../../lib/content';

export interface Props {
  settings?: SiteSettings;
}

const { settings } = Astro.props;
const brandName = settings?.brand_name ?? 'Viqar';
---

<header id="navigation" class="nav" data-8b-section="navigation">
  <a class="nav__brand" href="#hero" aria-label="Hello, back to the top"><span class="nav__brand-word">{brandName}</span><span class="m-dot" aria-hidden="true"></span></a>
  <button class="m-icon-btn nav__toggle" type="button" aria-expanded="false" aria-controls="menu"><span class="m-icon-btn__dot" aria-hidden="true"></span><span class="m-icon-btn__name">Open menu</span></button>
  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" data-lenis-prevent hidden>
    <div class="menu__top">
      <a class="menu__brand" href="#hero">{brandName}<span class="m-dot" aria-hidden="true"></span></a>
      <button class="m-icon-btn menu__close" type="button"><span class="m-icon-btn__dot" aria-hidden="true"></span><span class="m-icon-btn__name">Close menu</span></button>
    </div>
    <ul class="menu__list">
      <li><a href="#work">Work<span class="m-dot" aria-hidden="true"></span></a></li>
      <li><a href="#again">Skills<span class="m-dot" aria-hidden="true"></span></a></li>
      <li><a href="#capabilities">Recognitions<span class="m-dot" aria-hidden="true"></span></a></li>
      <li><a href="#method">Experience<span class="m-dot" aria-hidden="true"></span></a></li>
      <li><a href="#contact">Contact<span class="m-dot" aria-hidden="true"></span></a></li>
    </ul>
    <div class="menu__foot menu__socials">
      <a class="menu__social-link" href="https://github.com/placeholder" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
      <a class="menu__social-link" href="mailto:viqar@example.com">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="3"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span>Email</span>
      </a>
      <a class="menu__social-link" href="https://linkedin.com/in/placeholder" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.47 1.47 0 1 0 0-2.94 1.47 1.47 0 0 0 0 2.94m1.39 9.74V10.13H5.07v8.37h2.78z"/>
        </svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</header>
