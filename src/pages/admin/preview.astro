---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Header from '../../components/sections/Header.astro';
import Hero from '../../components/sections/Hero.astro';
import Statement from '../../components/sections/Statement.astro';
import Work from '../../components/sections/Work.astro';
import Again from '../../components/sections/Again.astro';
import Capabilities from '../../components/sections/Capabilities.astro';
import Method from '../../components/sections/Method.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/sections/Footer.astro';

import { createAstroServerClient, checkAdminUser } from '../../lib/supabase-server';
import {
  getSettings,
  getProjects,
  getSkills,
  getCredentials,
  getExperiences,
  getContactLinks,
} from '../../lib/content';
import {
  ProjectsSchema,
  SkillsSchema,
  CredentialsSchema,
  ExperiencesSchema,
  ContactLinksSchema,
} from '../../lib/schemas';

const client = createAstroServerClient(Astro);
const { user, isAdmin } = await checkAdminUser(client);

if (!user || !isAdmin) {
  return Astro.redirect('/admin/login');
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const settings = await getSettings();

let projects = await getProjects();
let skills = await getSkills();
let credentials = await getCredentials();
let experiences = await getExperiences();
let contactLinks = await getContactLinks();

try {
  const [pRes, sRes, cRes, eRes, clRes] = await Promise.all([
    client.from('projects').select('*').order('sort_order', { ascending: true }),
    client.from('skills').select('*').order('sort_order', { ascending: true }),
    client.from('credentials').select('*').order('sort_order', { ascending: true }),
    client.from('experiences').select('*').order('sort_order', { ascending: true }),
    client.from('contact_links').select('*').order('sort_order', { ascending: true }),
  ]);

  if (!pRes.error && pRes.data && pRes.data.length > 0) {
    const parsed = ProjectsSchema.safeParse(pRes.data);
    if (parsed.success) projects = parsed.data;
  }
  if (!sRes.error && sRes.data && sRes.data.length > 0) {
    const parsed = SkillsSchema.safeParse(sRes.data);
    if (parsed.success) skills = parsed.data;
  }
  if (!cRes.error && cRes.data && cRes.data.length > 0) {
    const parsed = CredentialsSchema.safeParse(cRes.data);
    if (parsed.success) credentials = parsed.data;
  }
  if (!eRes.error && eRes.data && eRes.data.length > 0) {
    const parsed = ExperiencesSchema.safeParse(eRes.data);
    if (parsed.success) experiences = parsed.data;
  }
  if (!clRes.error && clRes.data && clRes.data.length > 0) {
    const parsed = ContactLinksSchema.safeParse(clRes.data);
    if (parsed.success) contactLinks = parsed.data;
  }
} catch {
  // Fallbacks already loaded
}

const totalDrafts =
  projects.filter((p) => p.status === 'draft').length +
  skills.filter((s) => s.status === 'draft').length +
  credentials.filter((c) => c.status === 'draft').length +
  experiences.filter((e) => e.status === 'draft').length +
  contactLinks.filter((cl) => cl.status === 'draft').length;
---

<Base title={`[DRAFT PREVIEW] ${settings.site_title}`} description={settings.meta_description}>
  <!-- Floating Apple-style Draft Preview Banner -->
  <div
    style="position: fixed; top: 0; left: 0; right: 0; z-index: 99999; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); background: rgba(13, 12, 17, 0.88); color: #ffffff; font-family: 'Onest', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; font-weight: 500; padding: 10px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.6);"
  >
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #f6db00; box-shadow: 0 0 10px #f6db00;"></span>
      <span style="font-weight: 600; letter-spacing: -0.01em;">DRAFT PREVIEW MODE</span>
      <span style="color: #aaa7b4; font-size: 12px;">Viewing unpublished drafts alongside live content</span>
      <span style="background: rgba(246, 219, 0, 0.15); color: #f6db00; padding: 3px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
        {totalDrafts} Drafts Active
      </span>
    </div>
    <a
      href="/admin"
      style="background: #f6db00; color: #0d0c11; padding: 6px 14px; border-radius: 999px; text-decoration: none; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; transition: opacity 0.15s ease;"
      onmouseover="this.style.opacity='0.9'"
      onmouseout="this.style.opacity='1'"
    >
      &larr; Return to Admin
    </a>
  </div>

  <div style="padding-top: 52px;">
    <Header settings={settings} />
    <main id="main">
      <Hero settings={settings} />
      <Statement settings={settings} />
      <Work settings={settings} projects={projects} />
      <Again settings={settings} skills={skills} />
      <Capabilities settings={settings} credentials={credentials} />
      <Method settings={settings} experiences={experiences} />
      <Contact settings={settings} contactLinks={contactLinks} />
    </main>
    <Footer settings={settings} />
  </div>
</Base>
