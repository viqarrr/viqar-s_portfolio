---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import CredentialsManager from '../../components/admin/CredentialsManager';
// Integrates SortableList via CredentialsManager
import { createAstroServerClient, checkAdminUser } from '../../lib/supabase-server';
import { getCredentials } from '../../lib/content';

const client = createAstroServerClient(Astro);
const { user, isAdmin } = await checkAdminUser(client);

if (!user || !isAdmin) {
  return Astro.redirect('/admin/login');
}

let credentials: any[] = [];
try {
  const { data, error } = await client
    .from('credentials')
    .select('*')
    .order('sort_order', { ascending: true });

  if (!error && data && data.length > 0) {
    credentials = data;
  } else {
    credentials = await getCredentials();
  }
} catch {
  credentials = await getCredentials();
}
---

<AdminLayout title="Credentials & Honours" userEmail={user.email}>
  <CredentialsManager initialCredentials={credentials} client:only="react" />
</AdminLayout>
