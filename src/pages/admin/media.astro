---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaGallery from '../../components/admin/MediaGallery';
import { createAstroServerClient, checkAdminUser } from '../../lib/supabase-server';

const client = createAstroServerClient(Astro);
const { user, isAdmin } = await checkAdminUser(client);

if (!user || !isAdmin) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Media Library" userEmail={user.email}>
  <div class="space-y-6">
    <div class="mb-4">
      <h2 class="text-2xl font-heading font-extrabold text-white tracking-tight">Media Storage</h2>
      <p class="text-sm text-[#aaa7b4] font-sans mt-1">
        Upload portfolio project screenshots, credential documents, and vector SVG logos directly into Supabase Storage.
      </p>
    </div>

    <MediaGallery client:only="react" />
  </div>
</AdminLayout>
