---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import SettingsForm from '../../components/admin/SettingsForm';
import { createAstroServerClient, checkAdminUser } from '../../lib/supabase-server';
import { getSettings } from '../../lib/content';

const client = createAstroServerClient(Astro);
const { user, isAdmin } = await checkAdminUser(client);

if (!user || !isAdmin) {
  return Astro.redirect('/admin/login');
}

const settings = await getSettings();
---

<AdminLayout title="Site Settings" userEmail={user.email}>
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Global Site Settings</h2>
      <p class="text-sm text-slate-400 mt-1">
        Configure meta titles, OpenGraph images, hero leads, and dynamic statement lines.
      </p>
    </div>

    <SettingsForm initialSettings={settings} client:only="react" />
  </div>
</AdminLayout>
