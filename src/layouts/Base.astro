export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Viqar \u2014 Front-End, Mobile & Game Developer",
  description = "Viqar 'Ammar Zulfa Mulya is a Software and Game Development student at SMK Negeri 12 Surabaya specializing in front-end web, Flutter mobile, and Unity game programming."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content="8B Templates" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Personal developer portfolio of Viqar 'Ammar Zulfa Mulya. Front-end web development with Next.js & Laravel, mobile apps with Flutter, and game programming in Unity & C#." />
    <meta property="og:image" content="https://example.com/preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2064%2064'%3E%3Crect%20width%3D'64'%20height%3D'64'%20rx%3D'14'%20fill%3D'%236c3cff'%2F%3E%3Ctext%20x%3D'32'%20y%3D'45'%20font-family%3D'Arial%2CHelvetica%2Csans-serif'%20font-size%3D'38'%20font-weight%3D'700'%20text-anchor%3D'middle'%20fill%3D'%23ffffff'%3EV%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
