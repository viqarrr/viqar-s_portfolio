---
import '../styles/01.css';
import '../styles/02.css';
import '../styles/03.css';
import '../styles/04.css';
import '../styles/05.css';
import '../styles/06.css';
import '../styles/07.css';
import '../styles/08.css';
import '../styles/09.css';
import '../styles/10.css';
import '../styles/11.css';
import '../styles/12.css';
import '../styles/13.css';
import '../styles/14.css';
import '../styles/15.css';
import '../styles/16.css';
import '../styles/17.css';
import '../styles/18.css';
import '../styles/19.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Viqar \u2014 Front-End, Mobile & Game Developer",
  description = "Viqar 'Ammar Zulfa Mulya is a Software and Game Development student at SMK Negeri 12 Surabaya specializing in front-end web, Flutter mobile, and Unity game programming."
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://viqar.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/og.png', siteUrl).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Viqar 'Ammar Zulfa Mulya",
  "alternateName": "Viqar",
  "jobTitle": "Front-End, Mobile & Game Developer",
  "url": canonicalUrl,
  "sameAs": [
    "https://github.com/placeholder",
    "https://linkedin.com/in/placeholder"
  ],
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "SMK Negeri 12 Surabaya"
  },
  "knowsAbout": [
    "Front-End Web Development",
    "Next.js",
    "Laravel",
    "Flutter Mobile Development",
    "Unity Game Development",
    "C#",
    "TypeScript",
    "GSAP"
  ]
};

const jsonLdString = JSON.stringify(personSchema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content="8B Templates" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Viqar Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Viqar — Front-End, Mobile & Game Developer Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={jsonLdString} />

    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2064%2064'%3E%3Crect%20width%3D'64'%20height%3D'64'%20rx%3D'14'%20fill%3D'%236c3cff'%2F%3E%3Ctext%20x%3D'32'%20y%3D'45'%20font-family%3D'Arial%2CHelvetica%2Csans-serif'%20font-size%3D'38'%20font-weight%3D'700'%20text-anchor%3D'middle'%20fill%3D'%23ffffff'%3EV%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <link rel="preload" href="/fonts/gabarito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="m-text">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/00-vendor.ts';
      import '../scripts/04-section-script_navigation.ts';
      import '../scripts/05-section-script_hero.ts';
      import '../scripts/06-motion-queue.ts';
      import '../scripts/07-page-init.ts';
      import '../scripts/08-motion.ts';
      import '../scripts/09-scene_hero.ts';
      import '../scripts/10-scene_statement.ts';
      import '../scripts/11-scene_work.ts';
      import '../scripts/12-scene_again.ts';
      import '../scripts/13-scene_capabilities.ts';
      import '../scripts/14-scene_method.ts';
      import '../scripts/15-scene_contact.ts';
      import '../scripts/16-scene_footer.ts';
      import '../scripts/17-scene_project-detail.ts';
    </script>
  </body>
</html>
