---
export const prerender = false;

import '../styles/admin.css';
import PublishButton from '../components/admin/PublishButton';
import MobileNavDrawer from '../components/admin/MobileNavDrawer';

interface Props {
  title?: string;
  userEmail?: string;
}

const { title = 'Admin CMS', userEmail } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Overview', icon: 'dashboard' },
  { href: '/admin/settings', label: 'Site Settings', icon: 'settings' },
  { href: '/admin/projects', label: 'Projects', icon: 'folder' },
  { href: '/admin/skills', label: 'Skills & Tools', icon: 'sparkles' },
  { href: '/admin/credentials', label: 'Credentials', icon: 'award' },
  { href: '/admin/experiences', label: 'Experiences', icon: 'briefcase' },
  { href: '/admin/contact', label: 'Contact Links', icon: 'mail' },
  { href: '/admin/media', label: 'Media Library', icon: 'image' },
  { href: '/admin/preview', label: 'Draft Preview', icon: 'eye' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin CMS</title>
  </head>
  <body class="admin-body min-h-screen bg-[#0d0c11] text-white font-sans antialiased flex flex-col md:flex-row">
    <!-- Desktop Sidebar (Hidden on mobile) -->
    <aside class="hidden md:flex w-72 flex-shrink-0 h-screen sticky top-0 self-start flex-col justify-between overflow-y-auto bg-[#0d0c11] border-r border-white/[0.06] select-none admin-scrollbar z-20">
      <div class="flex flex-col min-h-0 flex-1">
        <!-- Studio Wordmark Header -->
        <div class="p-6 pb-6">
          <a href="/admin" class="inline-flex items-baseline group" aria-label="Viqar Admin Overview">
            <span class="font-display font-extrabold text-2xl tracking-tighter text-white">Viqar</span><span class="text-[#f6db00] font-display font-extrabold text-2xl leading-none">.</span>
          </a>
        </div>

        <!-- Navigation List -->
        <nav class="flex-1 px-4 py-1 space-y-1 overflow-y-auto admin-scrollbar">
          {navItems.map((item) => {
            const isActive = pathname === item.href || (item.href !== '/admin' && pathname.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`flex items-center justify-between px-4 py-2.5 text-sm rounded-full transition-all duration-150 min-h-[44px] active:scale-[0.98] ${
                  isActive
                    ? 'bg-[#1f1d26] text-white font-semibold shadow-sm'
                    : 'text-[#aaa7b4] hover:bg-[#1f1d26]/50 hover:text-white font-medium'
                }`}
              >
                <span>{item.label}</span>
                {isActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-[#f6db00] shadow-[0_0_8px_rgba(246,219,0,0.6)]"></span>
                )}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Sidebar Footer -->
      <div class="p-4 m-4 bg-[#1f1d26] rounded-[28px] space-y-2 border border-white/[0.04] flex-shrink-0">
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1.5 min-h-[44px] w-full px-3 py-2 text-xs font-semibold text-[#aaa7b4] hover:text-white bg-white/[0.04] hover:bg-white/[0.08] rounded-full transition-all active:scale-[0.98]"
        >
          <span>View Public Site</span>
          <span aria-hidden="true">↗</span>
        </a>
        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="flex items-center justify-center min-h-[44px] w-full px-3 py-2 text-xs font-semibold text-red-400 bg-red-500/10 hover:bg-red-500/20 rounded-full transition-all active:scale-[0.98]"
          >
            Sign Out
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen bg-[#0d0c11]">
      <!-- Mobile Sticky Header + Slide-Over Drawer (Only rendered on mobile) -->
      <MobileNavDrawer client:only="react" currentPath={pathname} userEmail={userEmail} />

      <!-- Desktop Header (Only rendered on desktop) -->
      <header class="hidden md:flex sticky top-0 z-30 h-16 px-8 bg-[#0d0c11]/85 backdrop-blur-md items-center justify-between flex-shrink-0 border-b border-white/[0.04]">
        <div class="flex items-center gap-2.5 min-w-0">
          <h1 class="font-heading font-extrabold text-xl text-white tracking-tight">{title}</h1>
        </div>

        <div class="flex items-center gap-2.5 flex-shrink-0">
          <PublishButton client:only="react" />
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            CMS Ready
          </div>
        </div>
      </header>

      <!-- Scrollable Main View Area (No mobile bottom navbar padding compensation) -->
      <main class="flex-1 px-4 py-6 md:p-8">
        <div class="max-w-6xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
