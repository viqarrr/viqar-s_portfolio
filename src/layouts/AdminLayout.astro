---
export const prerender = false;

import '../styles/admin.css';
import PublishButton from '../components/admin/PublishButton';
import MobileNavDrawer from '../components/admin/MobileNavDrawer';

interface Props {
  title?: string;
  userEmail?: string;
}

const { title = 'Admin CMS', userEmail } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Overview', icon: 'dashboard' },
  { href: '/admin/settings', label: 'Site Settings', icon: 'settings' },
  { href: '/admin/projects', label: 'Projects', icon: 'folder' },
  { href: '/admin/skills', label: 'Skills & Tools', icon: 'sparkles' },
  { href: '/admin/credentials', label: 'Credentials', icon: 'award' },
  { href: '/admin/experiences', label: 'Experiences', icon: 'briefcase' },
  { href: '/admin/contact', label: 'Contact Links', icon: 'mail' },
  { href: '/admin/media', label: 'Media Library', icon: 'image' },
  { href: '/admin/preview', label: 'Draft Preview', icon: 'eye' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin CMS</title>
  </head>
  <body class="admin-body min-h-screen bg-[#0d0c11] text-white font-sans antialiased flex flex-col md:flex-row">
    <!-- Desktop Sidebar (Hidden on mobile) -->
    <aside class="hidden md:flex w-72 flex-shrink-0 bg-[#18171f] flex-col min-h-screen select-none">
      <!-- Brand & Admin User Header -->
      <div class="p-6">
        <a href="/admin" class="flex items-center gap-2.5 group">
          <span class="w-3 h-3 rounded-full bg-[#6c3cff] shadow-[0_0_12px_rgba(108,60,255,0.7)] group-hover:scale-110 transition-transform"></span>
          <span class="font-heading font-extrabold text-xl tracking-tight text-white">Viqar Admin</span>
        </a>
        <div class="mt-2.5 px-3 py-1.5 bg-white/[0.04] rounded-xl flex items-center justify-between">
          <span class="text-xs text-[#aaa7b4] truncate font-medium">{userEmail || 'Administrator'}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        </div>
      </div>

      <!-- Navigation List -->
      <nav class="flex-1 px-4 py-2 space-y-1.5 overflow-y-auto admin-scrollbar">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/admin' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-2xl transition-all duration-150 min-h-[44px] active:scale-[0.98] ${
                isActive
                  ? 'bg-[#6c3cff] text-white font-semibold shadow-md'
                  : 'text-[#aaa7b4] hover:bg-[#1f1d26] hover:text-white'
              }`}
            >
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Sidebar Footer -->
      <div class="p-4 m-4 bg-white/[0.03] rounded-2xl space-y-2">
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center min-h-[44px] w-full px-3 py-2 text-xs font-semibold text-[#aaa7b4] hover:text-white bg-white/[0.04] hover:bg-white/[0.08] rounded-xl transition-all active:scale-[0.98]"
        >
          View Public Site &nearr;
        </a>
        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="flex items-center justify-center min-h-[44px] w-full px-3 py-2 text-xs font-semibold text-red-400 bg-red-500/10 hover:bg-red-500/20 rounded-xl transition-all active:scale-[0.98]"
          >
            Sign Out
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen bg-[#0d0c11]">
      <!-- Sticky Header -->
      <header class="sticky top-0 z-30 h-16 px-4 md:px-8 bg-[#0d0c11]/85 backdrop-blur-md flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-2.5 min-w-0">
          <!-- Mobile Brand Indicator + Current Section Title -->
          <div class="md:hidden flex items-center gap-2 min-w-0">
            <span class="w-2.5 h-2.5 rounded-full bg-[#6c3cff] flex-shrink-0"></span>
            <span class="font-heading font-extrabold text-base text-white tracking-tight flex-shrink-0">Viqar</span>
            <span class="text-white/20 font-light select-none">/</span>
            <span class="text-xs font-semibold text-[#aaa7b4] truncate max-w-[130px]">{title}</span>
          </div>
          <h1 class="hidden md:block font-heading font-extrabold text-xl text-white tracking-tight">{title}</h1>
        </div>

        <div class="flex items-center gap-2.5 flex-shrink-0">
          <PublishButton client:only="react" />
          <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            CMS Ready
          </div>
        </div>
      </header>

      <!-- Scrollable Main View Area -->
      <main class="flex-1 px-4 py-6 md:p-8 pb-28 md:pb-8">
        <div class="max-w-6xl mx-auto">
          <slot />
        </div>
      </main>
    </div>

    <!-- Mobile Navigation Drawer / iOS Frosted Bottom Bar -->
    <MobileNavDrawer client:only="react" currentPath={pathname} userEmail={userEmail} />
  </body>
</html>
